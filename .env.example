# LocalKart - Hyperlocal Marketplace & Same-day Delivery Platform
# Environment Configuration

# Database Configuration (Optional: defaults to built-in relational file database if not set)
DATABASE_URL=postgresql://postgres:password@localhost:5432/localkart
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payments
# Leave blank or set test keys for mock simulator mode
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
MOCK_PAYMENT_ENABLED=true

# Application
NEXT_PUBLIC_APP_NAME=LocalKart
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=super-secret-localkart-jwt-token-key-change-in-production
